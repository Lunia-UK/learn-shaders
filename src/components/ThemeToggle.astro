---
// Switches between light and dark. The page follows the system setting until the learner
// picks one; the choice is saved and applied before the first paint by BaseLayout.
---

<button type="button" class="btn theme-toggle" data-theme-toggle hidden>
  <svg data-icon="dark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="currentColor"></path>
  </svg>
  <svg data-icon="light" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
    <path
      d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    ></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');

  function currentTheme(): 'light' | 'dark' {
    const chosen = root.dataset.theme;
    if (chosen === 'light' || chosen === 'dark') return chosen;
    return systemDark.matches ? 'dark' : 'light';
  }

  function refresh(button: HTMLButtonElement) {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    button.dataset.next = next;
    button.setAttribute('aria-label', `Switch to the ${next} theme`);
    // The icon shows the theme the button switches to.
    for (const icon of button.querySelectorAll<SVGElement>('[data-icon]')) {
      icon.style.display = icon.dataset.icon === next ? '' : 'none';
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    // Without JavaScript the button could not work, so it only shows up here.
    button.hidden = false;
    refresh(button);
    button.addEventListener('click', () => {
      const next = button.dataset.next as 'light' | 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Blocked storage: the theme still changes for this page.
      }
      refresh(button);
    });
    systemDark.addEventListener('change', () => refresh(button));
  }
</script>

<style>
  .theme-toggle {
    padding: 0.5rem;
  }
</style>
