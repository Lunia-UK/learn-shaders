---
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLessons, lessonHref } from '../lessons/load';

const [first] = await getLessons();
---

<BaseLayout>
  <main>
    <h1>{site.name}</h1>
    <p class="intro">{site.description}</p>
    {first && (
      <a class="btn btn-primary" href={lessonHref(first)}>
        Start with lesson 1: {first.entry.data.title}
      </a>
    )}
  </main>
</BaseLayout>

<style>
  main {
    max-width: 40rem;
  }

  h1 {
    margin: 0 0 0.6rem;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .intro {
    margin: 0 0 1.5rem;
    font-size: 1.15rem;
    color: var(--muted);
  }
</style>
