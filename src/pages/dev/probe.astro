---
// Dev check for the pixel probe. Used by tests/e2e/probe.spec.ts. Not linked from the site.
import { site } from '../../config/site';
import { ProbeCheck } from '../../components/dev/ProbeCheck';
import '../../styles/tokens.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Probe check · {site.name}</title>
  </head>
  <body>
    <main>
      <h1>Pixel probe check</h1>
      <p>
        Click or drag on the image to choose a pixel, or Tab to the probe and use the arrow keys.
        Each line of code shows its value at that pixel.
      </p>
      <ProbeCheck client:load />
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
    color: var(--ink);
    background: var(--paper);
  }

  main {
    max-width: 56rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
</style>
