---
import { site } from '../config/site';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <title>{site.name}</title>
  </head>
  <body>
    <main>
      <h1>{site.name}</h1>
      <p>{site.description}</p>
      <p class="note">Under construction.</p>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    --bg: #fafaf8;
    --fg: #1b1b1f;
    --muted: #6b6b75;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121215;
      --fg: #ececf1;
      --muted: #9a9aa6;
    }
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  main {
    max-width: 40rem;
    margin: 0 auto;
    padding: 4rem 1rem;
  }

  .note {
    color: var(--muted);
  }
</style>
