---
// One page per lesson. Building it loads every lesson, so a broken lesson fails the build here.
import LessonLayout from '../../layouts/LessonLayout.astro';
import { getLessons, type Lesson } from '../../lessons/load';

export async function getStaticPaths() {
  const lessons = await getLessons();
  return lessons.map((lesson, i) => ({
    params: { slug: lesson.slug },
    props: {
      lesson,
      chapterLessons: lessons.filter((l) => l.chapter.id === lesson.chapter.id),
      next: lessons[i + 1] ?? null,
    },
  }));
}

const { lesson, chapterLessons, next } = Astro.props as {
  lesson: Lesson;
  chapterLessons: Lesson[];
  next: Lesson | null;
};
---

<LessonLayout lesson={lesson} chapterLessons={chapterLessons} next={next} />
