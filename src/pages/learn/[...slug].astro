---
// One page per lesson. A plain placeholder for now: LessonLayout (PLAN 0.10) replaces it.
// Building this page loads every lesson, so a missing .glsl file fails the build here.
import { render } from 'astro:content';
import { site } from '../../config/site';
import { getLessons, type Lesson } from '../../lessons/load';

export async function getStaticPaths() {
  const lessons = await getLessons();
  return lessons.map((lesson) => ({ params: { slug: lesson.slug }, props: { lesson } }));
}

const { lesson } = Astro.props as { lesson: Lesson };
const { data } = lesson.entry;
const { Content } = await render(lesson.entry);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={data.idea} />
    <title>{data.title} · {site.name}</title>
  </head>
  <body>
    <main>
      <h1>{data.title}</h1>
      <p class="idea">{data.idea}</p>
      <Content />
      <h2>Starter code</h2>
      <pre><code>{lesson.starterCode}</code></pre>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
  }

  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  main {
    max-width: 40rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .idea {
    font-size: 1.15rem;
  }

  pre {
    padding: 1rem;
    overflow-x: auto;
    border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    border-radius: 6px;
  }
</style>
